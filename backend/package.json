{
  "name": "godan-desktop",
  "version": "1.0.0",
  "description": "Godan Desktop Calculator App",
  "main": "main.js",
  "author": "Godan",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },

  "keywords": [
    "calculator",
    "electron",
    "macos",
    "godan"
  ],

  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },

  "build": {
    "appId": "com.godan.calculator",
    "productName": "Godan计算器",

    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "icon.icns"
    },

    "files": [
      "**/*",
      "!node_modules/.cache"
    ]
  }
}