{
  "name": "godan",
  "version": "1.1.0",
  "description": "Godan — macOS 电脑操作 Agent：自然语言创建/修改应用，并直接操控你的电脑完成多步骤任务（AX 控件、文件系统、终端、Watch 等待、失败自修复）",
  "main": "main.cjs",
  "type": "commonjs",
  "author": "dadajishi <woshidadadajishi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadajishi/godan.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "npm run electron",
    "dist": "electron-builder",
    "bench": "node backend/benchmark.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "ollama": "^0.6.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.godan.ai",
    "productName": "Godan",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**",
      "backend/**",
      "!**/node_modules/playwright/**",
      "!**/node_modules/playwright-core/**",
      "!**/node_modules/.bin/playwright*",
      "!backend/node_modules/.cache/**",
      "!backend/*.db",
      "!backend/.env",
      "!backend/.env.*",
      "!backend/projects.json",
      "!backend/last_project.json",
      "!backend/state.json",
      "!backend/oplog.jsonl",
      "!backend/memory/state.json"
    ],
    "asarUnpack": [
      "backend/node_modules/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Godan ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false,
      "files": [
        "main.cjs",
        "preload.cjs",
        "dist/**",
        "backend/**",
        "!**/node_modules/playwright/**",
        "!**/node_modules/playwright-core/**",
        "!**/node_modules/.bin/playwright*",
        "!backend/node_modules/.cache/**",
        "!backend/*.db",
        "!backend/.env",
        "!backend/.env.*",
        "!backend/projects.json",
        "!backend/last_project.json",
        "!backend/state.json",
        "!backend/oplog.jsonl",
        "!backend/memory/state.json"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "disableAsarIntegrity": true
  }
}